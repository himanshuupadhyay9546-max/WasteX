# WasteX / EcoRoute Environment Variables (Template / Non-Secret)

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & Auth (Do NOT put production secrets in repository)
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 + PostGIS + TimescaleDB)
POSTGRES_USER=wastex_admin
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=wastex_bhopal_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wastex_admin:your_secure_db_password_here@postgres:5432/wastex_bhopal_db

# Redis Cache & Message Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_TOPIC_TELEMETRY=wastex/bins/+/telemetry
MQTT_TOPIC_ALERTS=wastex/alerts/#
MQTT_TOPIC_TRUCKS=wastex/trucks/+/location

# Storage (MinIO / S3 Compatible)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=wastex_storage_user
MINIO_ROOT_PASSWORD=your_secure_storage_password_here
MINIO_BUCKET_MEDIA=wastex-media
MINIO_BUCKET_MODELS=wastex-models

# Services URLs
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
ROUTER_SERVICE_URL=http://router:8001
ML_SERVICE_URL=http://ml-worker:8002
WEB_PORT=3000

# External APIs (Optional Keys)
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
FIREBASE_CREDENTIALS_PATH=/app/firebase-admin.json

# IoT & Simulation Config (Bhopal Municipal Corporation)
SIMULATOR_NUM_BINS=500
SIMULATOR_NUM_TRUCKS=8
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_CITY_LAT=23.2500
SIMULATOR_CITY_LNG=77.4126
SIMULATOR_CITY_NAME=Bhopal
